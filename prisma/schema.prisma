generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  id        String   @id
  email     String   @unique(map: "Admin_email_key")
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model album {
  id              String        @id
  title           String
  slug            String        @unique(map: "Album_slug_key")
  coverImage      String?
  releaseDate     DateTime?
  label           String?
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  artistId        String
  artist          artist        @relation(fields: [artistId], references: [id], map: "Album_artistId_fkey")
  albumrating     albumrating[]
  blogpost        blogpost[]
  song            song[]

  @@index([artistId], map: "Album_artistId_fkey")
  @@index([slug], map: "Album_slug_idx")
  @@index([title], map: "Album_title_idx")
}

model albumrating {
  id        String   @id
  albumId   String
  ipAddress String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  album     album    @relation(fields: [albumId], references: [id], onDelete: Cascade, map: "AlbumRating_albumId_fkey")

  @@unique([albumId, ipAddress], map: "AlbumRating_albumId_ipAddress_key")
  @@index([albumId], map: "AlbumRating_albumId_idx")
}

model annotation {
  id        String   @id
  songId    String
  startLine Int
  endLine   Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime
  song      song     @relation(fields: [songId], references: [id], onDelete: Cascade, map: "Annotation_songId_fkey")

  @@index([songId], map: "Annotation_songId_idx")
}

model appvisit {
  id        String   @id
  ipAddress String?
  userAgent String?  @db.Text
  platform  String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt], map: "AppVisit_createdAt_idx")
  @@index([ipAddress], map: "AppVisit_ipAddress_idx")
}

model artist {
  id              String         @id
  name            String
  slug            String         @unique(map: "Artist_slug_key")
  bio             String?        @db.Text
  imageUrl        String?
  country         String?
  socialLinks     String?        @db.Text
  metaTitle       String?
  metaDescription String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  album           album[]
  artistrating    artistrating[]
  blogpost        blogpost[]
  songartist      songartist[]

  @@index([name], map: "Artist_name_idx")
  @@index([slug], map: "Artist_slug_idx")
}

model artistrating {
  id        String   @id
  artistId  String
  ipAddress String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  artist    artist   @relation(fields: [artistId], references: [id], onDelete: Cascade, map: "ArtistRating_artistId_fkey")

  @@unique([artistId, ipAddress], map: "ArtistRating_artistId_ipAddress_key")
  @@index([artistId], map: "ArtistRating_artistId_idx")
}

model blogcategory {
  id          String     @id
  name        String
  slug        String     @unique(map: "BlogCategory_slug_key")
  description String?    @db.Text
  color       String?
  icon        String?
  sortOrder   Int        @default(0)
  blogpost    blogpost[]

  @@index([slug], map: "BlogCategory_slug_idx")
}

model blogpost {
  id                                    String       @id
  title                                 String
  slug                                  String       @unique(map: "BlogPost_slug_key")
  excerpt                               String       @db.Text
  content                               String       @db.LongText
  coverImage                            String?
  ogImage                               String?
  metaTitle                             String?
  metaDescription                       String?      @db.Text
  metaKeywords                          String?      @db.Text
  author                                String       @default("Admin")
  status                                String       @default("draft")
  isFeatured                            Boolean      @default(false)
  readTime                              Int?
  views                                 Int          @default(0)
  tags                                  String?      @db.Text
  blogCategoryId                        String
  relatedSongId                         String?
  relatedMovieId                        String?
  relatedArtistId                       String?
  relatedAlbumId                        String?
  publishedAt                           DateTime?
  createdAt                             DateTime     @default(now())
  updatedAt                             DateTime
  blogcategory                          blogcategory @relation(fields: [blogCategoryId], references: [id], map: "BlogPost_blogCategoryId_fkey")
  album                                 album?       @relation(fields: [relatedAlbumId], references: [id], map: "BlogPost_relatedAlbumId_fkey")
  artist                                artist?      @relation(fields: [relatedArtistId], references: [id], map: "BlogPost_relatedArtistId_fkey")
  movie                                 movie?       @relation(fields: [relatedMovieId], references: [id], map: "BlogPost_relatedMovieId_fkey")
  song_blogpost_relatedSongIdTosong     song?        @relation("blogpost_relatedSongIdTosong", fields: [relatedSongId], references: [id], map: "BlogPost_relatedSongId_fkey")
  song_song_relatedBlogPostIdToblogpost song[]       @relation("song_relatedBlogPostIdToblogpost")

  @@index([blogCategoryId], map: "BlogPost_blogCategoryId_idx")
  @@index([isFeatured], map: "BlogPost_isFeatured_idx")
  @@index([publishedAt], map: "BlogPost_publishedAt_idx")
  @@index([relatedAlbumId], map: "BlogPost_relatedAlbumId_fkey")
  @@index([relatedArtistId], map: "BlogPost_relatedArtistId_fkey")
  @@index([relatedMovieId], map: "BlogPost_relatedMovieId_fkey")
  @@index([relatedSongId], map: "BlogPost_relatedSongId_fkey")
  @@index([slug], map: "BlogPost_slug_idx")
  @@index([status], map: "BlogPost_status_idx")
  @@index([views], map: "BlogPost_views_idx")
}

model bulkimport {
  id            String          @id
  site          String
  status        String          @default("pending")
  totalUrls     Int             @default(0)
  scraped       Int             @default(0)
  failed        Int             @default(0)
  skipped       Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  bulkimporturl bulkimporturl[]
}

model bulkimporturl {
  id         String     @id
  importId   String
  url        String     @db.Text
  status     String     @default("pending")
  songId     String?
  error      String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  bulkimport bulkimport @relation(fields: [importId], references: [id], onDelete: Cascade, map: "BulkImportUrl_importId_fkey")

  @@index([importId, status], map: "BulkImportUrl_importId_status_idx")
}

model category {
  id              String         @id
  name            String         @unique(map: "Category_name_key")
  slug            String         @unique(map: "Category_slug_key")
  createdAt       DateTime       @default(now())
  metaDescription String?        @db.Text
  metaTitle       String?
  description     String?        @db.Text
  imageUrl        String?
  songcategory    songcategory[]
  toplist         toplist[]

  @@index([slug], map: "Category_slug_idx")
}

model dailyquiz {
  id                  String                @id
  language            String
  date                String
  playCount           Int                   @default(0)
  songIds             String                @db.Text
  createdAt           DateTime              @default(now())
  dailyquizquestion   dailyquizquestion[]
  dailyquizsubmission dailyquizsubmission[]

  @@unique([language, date], map: "DailyQuiz_language_date_key")
  @@index([language, date], map: "DailyQuiz_language_date_idx")
}

model dailyquizquestion {
  id           String    @id
  quizId       String
  order        Int
  type         String
  lyricSnippet String    @db.Text
  question     String    @db.Text
  options      String    @db.Text
  correctIndex Int
  explanation  String?   @db.Text
  songId       String?
  songSlug     String?
  songTitle    String?
  dailyquiz    dailyquiz @relation(fields: [quizId], references: [id], onDelete: Cascade, map: "DailyQuizQuestion_quizId_fkey")

  @@index([quizId], map: "DailyQuizQuestion_quizId_idx")
}

model dailyquizsubmission {
  id          String    @id
  quizId      String
  sessionId   String
  displayName String?
  score       Int
  timeTaken   Int
  streak      Int       @default(1)
  submittedAt DateTime  @default(now())
  dailyquiz   dailyquiz @relation(fields: [quizId], references: [id], onDelete: Cascade, map: "DailyQuizSubmission_quizId_fkey")

  @@index([quizId, score, timeTaken], map: "DailyQuizSubmission_quizId_score_timeTaken_idx")
  @@index([sessionId], map: "DailyQuizSubmission_sessionId_idx")
}

model genre {
  id              String      @id
  name            String      @unique(map: "Genre_name_key")
  slug            String      @unique(map: "Genre_slug_key")
  description     String?     @db.Text
  imageUrl        String?
  createdAt       DateTime    @default(now())
  metaDescription String?     @db.Text
  metaTitle       String?
  songgenre       songgenre[]

  @@index([slug], map: "Genre_slug_idx")
}

model movie {
  id              String        @id
  title           String
  year            Int?
  director        String?
  createdAt       DateTime      @default(now())
  posterUrl       String?
  slug            String?       @unique(map: "Movie_slug_key")
  cast            String?       @db.Text
  description     String?       @db.Text
  genre           String?
  language        String?
  metaDescription String?       @db.Text
  metaTitle       String?
  musicDirector   String?
  producer        String?
  writer          String?
  blogpost        blogpost[]
  movierating     movierating[]
  song            song[]

  @@index([slug], map: "Movie_slug_idx")
  @@index([title], map: "Movie_title_idx")
  @@index([year], map: "Movie_year_idx")
}

model movierating {
  id        String   @id
  movieId   String
  ipAddress String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  movie     movie    @relation(fields: [movieId], references: [id], onDelete: Cascade, map: "MovieRating_movieId_fkey")

  @@unique([movieId, ipAddress], map: "MovieRating_movieId_ipAddress_key")
  @@index([movieId], map: "MovieRating_movieId_idx")
}

model newsletter {
  id         String    @id
  subject    String
  content    String    @db.Text
  status     String    @default("draft")
  sentAt     DateTime?
  sentTo     Int       @default(0)
  openCount  Int       @default(0)
  clickCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
}

model newslettersubscriber {
  id             String    @id
  email          String    @unique(map: "NewsletterSubscriber_email_key")
  name           String?
  status         String    @default("active")
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  ipAddress      String?

  @@index([email], map: "NewsletterSubscriber_email_idx")
  @@index([status], map: "NewsletterSubscriber_status_idx")
}

model page {
  id              String   @id
  slug            String   @unique(map: "Page_slug_key")
  title           String
  content         String   @db.LongText
  metaTitle       String?
  metaDescription String?  @db.Text
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([slug], map: "Page_slug_idx")
}

model redirect {
  id        String   @id
  oldUrl    String   @unique(map: "Redirect_oldUrl_key")
  newUrl    String
  type      Int      @default(301)
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([isActive], map: "Redirect_isActive_idx")
  @@index([oldUrl], map: "Redirect_oldUrl_idx")
}

model report {
  id            String   @id
  type          String
  description   String?  @db.Text
  status        String   @default("pending")
  songId        String?
  reporterIp    String?
  reporterEmail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  song          song?    @relation(fields: [songId], references: [id], onDelete: Cascade, map: "Report_songId_fkey")

  @@index([songId], map: "Report_songId_idx")
  @@index([status], map: "Report_status_idx")
}

model searchevent {
  id          String   @id
  query       String
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([createdAt], map: "SearchEvent_createdAt_idx")
  @@index([query], map: "SearchEvent_query_idx")
}

model siteseosettings {
  id              String   @id
  pageKey         String   @unique(map: "SiteSeoSettings_pageKey_key")
  pageTitle       String?
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?  @db.Text
  ogTitle         String?
  ogDescription   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  ogImage         String?

  @@index([pageKey], map: "SiteSeoSettings_pageKey_idx")
}

model song {
  id                                        String           @id
  title                                     String
  slug                                      String           @unique(map: "Song_slug_key")
  lyrics                                    String           @db.Text
  duration                                  String?
  language                                  String?
  verified                                  Boolean          @default(false)
  views                                     Int              @default(0)
  status                                    String           @default("published")
  metaTitle                                 String?
  metaDescription                           String?          @db.Text
  coverImage                                String?
  createdAt                                 DateTime         @default(now())
  updatedAt                                 DateTime
  albumId                                   String?
  movieId                                   String?
  youtubeUrl                                String?
  composer                                  String?
  director                                  String?
  label                                     String?
  lyricist                                  String?
  producer                                  String?
  singers                                   String?
  spotifyUrl                                String?
  starring                                  String?
  lyricsRomanized                           String?          @db.Text
  lyricsTranslated                          String?          @db.Text
  likes                                     Int              @default(0)
  meaning                                   String?          @db.Text
  lyricsHindi                               String?          @db.Text
  lyricsPunjabi                             String?          @db.Text
  appleMusicUrl                             String?
  datePublished                             DateTime?
  dateModified                              DateTime?
  hasWebStory                               Boolean          @default(false)
  ogImage                                   String?
  relatedBlogPostId                         String?
  annotation                                annotation[]
  blogpost_blogpost_relatedSongIdTosong     blogpost[]       @relation("blogpost_relatedSongIdTosong")
  report                                    report[]
  album                                     album?           @relation(fields: [albumId], references: [id], map: "Song_albumId_fkey")
  movie                                     movie?           @relation(fields: [movieId], references: [id], map: "Song_movieId_fkey")
  blogpost_song_relatedBlogPostIdToblogpost blogpost?        @relation("song_relatedBlogPostIdToblogpost", fields: [relatedBlogPostId], references: [id], map: "Song_relatedBlogPostId_fkey")
  songartist                                songartist[]
  songcategory                              songcategory[]
  songgenre                                 songgenre[]
  songlike                                  songlike[]
  songrating                                songrating[]
  songreaction                              songreaction[]
  songshareevent                            songshareevent[]
  songtag                                   songtag[]

  @@index([albumId], map: "Song_albumId_idx")
  @@index([createdAt], map: "Song_createdAt_idx")
  @@index([datePublished], map: "Song_datePublished_idx")
  @@index([hasWebStory], map: "Song_hasWebStory_idx")
  @@index([movieId], map: "Song_movieId_idx")
  @@index([relatedBlogPostId], map: "Song_relatedBlogPostId_fkey")
  @@index([slug], map: "Song_slug_idx")
  @@index([status], map: "Song_status_idx")
  @@index([title], map: "Song_title_idx")
  @@index([views], map: "Song_views_idx")
}

model songartist {
  songId   String
  artistId String
  artist   artist @relation(fields: [artistId], references: [id], onDelete: Cascade, map: "SongArtist_artistId_fkey")
  song     song   @relation(fields: [songId], references: [id], onDelete: Cascade, map: "SongArtist_songId_fkey")

  @@id([songId, artistId])
  @@index([artistId], map: "SongArtist_artistId_fkey")
}

model songcategory {
  songId     String
  categoryId String
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "SongCategory_categoryId_fkey")
  song       song     @relation(fields: [songId], references: [id], onDelete: Cascade, map: "SongCategory_songId_fkey")

  @@id([songId, categoryId])
  @@index([categoryId], map: "SongCategory_categoryId_fkey")
}

model songgenre {
  songId  String
  genreId String
  genre   genre  @relation(fields: [genreId], references: [id], onDelete: Cascade, map: "SongGenre_genreId_fkey")
  song    song   @relation(fields: [songId], references: [id], onDelete: Cascade, map: "SongGenre_songId_fkey")

  @@id([songId, genreId])
  @@index([genreId], map: "SongGenre_genreId_fkey")
}

model songlike {
  id        String   @id
  songId    String
  ipAddress String
  createdAt DateTime @default(now())
  song      song     @relation(fields: [songId], references: [id], onDelete: Cascade, map: "SongLike_songId_fkey")

  @@unique([songId, ipAddress], map: "SongLike_songId_ipAddress_key")
  @@index([ipAddress], map: "SongLike_ipAddress_idx")
  @@index([songId], map: "SongLike_songId_idx")
}

model songrating {
  id        String   @id
  songId    String
  ipAddress String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  song      song     @relation(fields: [songId], references: [id], onDelete: Cascade, map: "SongRating_songId_fkey")

  @@unique([songId, ipAddress], map: "SongRating_songId_ipAddress_key")
  @@index([songId], map: "SongRating_songId_idx")
}

model songreaction {
  id        String   @id
  songId    String
  ipAddress String
  emoji     String
  createdAt DateTime @default(now())
  song      song     @relation(fields: [songId], references: [id], onDelete: Cascade, map: "SongReaction_songId_fkey")

  @@unique([songId, ipAddress, emoji], map: "SongReaction_songId_ipAddress_emoji_key")
  @@index([songId], map: "SongReaction_songId_idx")
}

model songrequest {
  id              String   @id
  songName        String
  artistName      String
  lyrics          String?  @db.Text
  youtubeUrl      String?
  spotifyUrl      String?
  email           String
  newsletterOptIn Boolean  @default(false)
  ipAddress       String?
  status          String   @default("pending")
  adminNotes      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([createdAt], map: "SongRequest_createdAt_idx")
  @@index([email], map: "SongRequest_email_idx")
  @@index([status], map: "SongRequest_status_idx")
}

model songshareevent {
  id        String   @id
  songId    String
  type      String
  createdAt DateTime @default(now())
  song      song     @relation(fields: [songId], references: [id], onDelete: Cascade, map: "SongShareEvent_songId_fkey")

  @@index([createdAt], map: "SongShareEvent_createdAt_idx")
  @@index([songId], map: "SongShareEvent_songId_idx")
  @@index([type], map: "SongShareEvent_type_idx")
}

model songtag {
  songId String
  tagId  String
  song   song   @relation(fields: [songId], references: [id], onDelete: Cascade, map: "SongTag_songId_fkey")
  tag    tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "SongTag_tagId_fkey")

  @@id([songId, tagId])
  @@index([tagId], map: "SongTag_tagId_fkey")
}

model tag {
  id              String    @id
  name            String    @unique(map: "Tag_name_key")
  slug            String    @unique(map: "Tag_slug_key")
  createdAt       DateTime  @default(now())
  description     String?   @db.Text
  metaDescription String?   @db.Text
  metaTitle       String?
  songtag         songtag[]
  toplist         toplist[]

  @@index([slug], map: "Tag_slug_idx")
}

model toplist {
  id              String    @id
  title           String
  slug            String    @unique(map: "TopList_slug_key")
  count           Int       @default(50)
  categoryId      String?
  description     String?   @db.Text
  metaTitle       String?
  metaDescription String?   @db.Text
  isPublished     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  tagId           String?
  category        category? @relation(fields: [categoryId], references: [id], map: "TopList_categoryId_fkey")
  tag             tag?      @relation(fields: [tagId], references: [id], map: "TopList_tagId_fkey")

  @@index([categoryId], map: "TopList_categoryId_idx")
  @@index([slug], map: "TopList_slug_idx")
  @@index([tagId], map: "TopList_tagId_idx")
}

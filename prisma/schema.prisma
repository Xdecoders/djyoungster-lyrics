generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Song {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  lyrics          String   @db.Text
  lyricsRomanized String?  @db.Text  // Transliterated lyrics (Roman script)
  lyricsTranslated String? @db.Text  // English translation
  lyricsHindi     String?  @db.Text  // Hindi version of lyrics
  lyricsPunjabi   String?  @db.Text  // Punjabi version of lyrics
  meaning         String?  @db.Text  // Song meaning/interpretation
  duration        String?
  language        String?
  releaseYear     Int?
  verified        Boolean  @default(false)
  views           Int      @default(0)
  likes           Int      @default(0)
  status          String   @default("published")
  metaTitle       String?
  metaDescription String?  @db.Text
  coverImage      String?
  youtubeUrl      String?
  spotifyUrl      String?
  appleMusicUrl   String?

  // Contributors
  lyricist        String?  // Writer/Lyricist
  composer        String?  // Music Composer/Director
  singers         String?  // Additional singers (comma separated)
  label           String?  // Music Label/Copyright Company
  starring        String?  // Models/Starring (comma separated)
  producer        String?  // Music Producer
  director        String?  // Music Video Director

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  album      Album?         @relation(fields: [albumId], references: [id])
  albumId    String?
  movie      Movie?         @relation(fields: [movieId], references: [id])
  movieId    String?
  artists    SongArtist[]
  genres     SongGenre[]
  categories SongCategory[]
  tags       SongTag[]
  songLikes  SongLike[]
  reports    Report[]
  ratings    SongRating[]
  reactions  SongReaction[]
  annotations Annotation[]

  @@index([slug])
  @@index([title])
  @@index([views])
  @@index([createdAt])
  @@index([status])
  @@index([albumId])
  @@index([movieId])
}

model SongLike {
  id        String   @id @default(uuid())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String
  ipAddress String
  createdAt DateTime @default(now())

  @@unique([songId, ipAddress])
  @@index([songId])
  @@index([ipAddress])
}

model Artist {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  bio             String?  @db.Text
  imageUrl        String?
  country         String?
  socialLinks     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  songs   SongArtist[]
  albums  Album[]
  ratings ArtistRating[]

  @@index([slug])
  @@index([name])
}

model Album {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  coverImage      String?
  releaseDate     DateTime?
  label           String?
  metaTitle       String?
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artist   Artist @relation(fields: [artistId], references: [id])
  artistId String
  songs    Song[]
  ratings  AlbumRating[]

  @@index([slug])
  @@index([title])
}

model Genre {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  imageUrl        String?
  metaTitle       String?
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())

  songs SongGenre[]

  @@index([slug])
}

model Category {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  description     String?  @db.Text
  imageUrl        String?
  metaTitle       String?
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())

  songs SongCategory[]
  topLists TopList[]

  @@index([slug])
}

model TopList {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  count           Int      @default(50)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  tagId           String?
  tag             Tag?      @relation(fields: [tagId], references: [id])
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([tagId])
}

model SiteSeoSettings {
  id              String   @id @default(uuid())
  pageKey         String   @unique  // homepage, songs, artists, albums, movies, genres
  pageTitle       String?
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?  @db.Text
  ogTitle         String?
  ogDescription   String?  @db.Text
  ogImage         String?  // OG image URL for social media sharing
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([pageKey])
}

model Movie {
  id              String   @id @default(uuid())
  title           String
  slug            String?  @unique
  year            Int?
  director        String?
  posterUrl       String?
  description     String?  @db.Text
  cast            String?  @db.Text  // Starring actors (comma separated)
  producer        String?
  musicDirector   String?            // Music Director/Composer
  writer          String?            // Screenplay/Story Writer
  genre           String?            // Movie genre
  language        String?            // Movie language
  metaTitle       String?
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())

  songs   Song[]
  ratings MovieRating[]

  @@index([slug])
  @@index([title])
  @@index([year])
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SongArtist {
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId   String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artistId String

  @@id([songId, artistId])
}

model SongGenre {
  song    Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId  String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String

  @@id([songId, genreId])
}

model SongCategory {
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId     String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([songId, categoryId])
}

model Tag {
  id              String    @id @default(uuid())
  name            String    @unique
  slug            String    @unique
  description     String?   @db.Text
  metaTitle       String?
  metaDescription String?   @db.Text
  createdAt       DateTime  @default(now())

  songs    SongTag[]
  topLists TopList[]

  @@index([slug])
}

model SongTag {
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([songId, tagId])
}

model Report {
  id          String   @id @default(uuid())
  type        String   // lyrics, spelling, artist, album, credits, other
  description String?  @db.Text
  status      String   @default("pending") // pending, reviewed, resolved

  // Related content
  songId      String?
  song        Song?    @relation(fields: [songId], references: [id], onDelete: Cascade)

  // Reporter info
  reporterIp  String?
  reporterEmail String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([songId])
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  status       String   @default("active") // active, unsubscribed
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
  ipAddress    String?

  @@index([email])
  @@index([status])
}

model Newsletter {
  id          String   @id @default(uuid())
  subject     String
  content     String   @db.Text
  status      String   @default("draft") // draft, sent
  sentAt      DateTime?
  sentTo      Int      @default(0) // Number of recipients
  openCount   Int      @default(0)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Page {
  id              String   @id @default(uuid())
  slug            String   @unique  // about-us, privacy-policy, terms-and-conditions, disclaimer, contact-us
  title           String
  content         String   @db.LongText
  metaTitle       String?
  metaDescription String?  @db.Text
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
}

model BulkImport {
  id        String   @id @default(uuid())
  site      String
  status    String   @default("pending") // pending, discovering, running, paused, completed
  totalUrls Int      @default(0)
  scraped   Int      @default(0)
  failed    Int      @default(0)
  skipped   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  urls      BulkImportUrl[]
}

model BulkImportUrl {
  id        String     @id @default(uuid())
  importId  String
  import    BulkImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  url       String     @db.Text
  status    String     @default("pending") // pending, scraped, failed, skipped
  songId    String?
  error     String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([importId, status])
}

model SongRating {
  id        String   @id @default(uuid())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String
  ipAddress String
  rating    Int      // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([songId, ipAddress])
  @@index([songId])
}

model SongReaction {
  id        String   @id @default(uuid())
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId    String
  ipAddress String
  emoji     String   // fire, heart, sad, party, hundred
  createdAt DateTime @default(now())

  @@unique([songId, ipAddress, emoji])
  @@index([songId])
}

model ArtistRating {
  id        String   @id @default(uuid())
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artistId  String
  ipAddress String
  rating    Int      // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, ipAddress])
  @@index([artistId])
}

model AlbumRating {
  id        String   @id @default(uuid())
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId   String
  ipAddress String
  rating    Int      // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([albumId, ipAddress])
  @@index([albumId])
}

model MovieRating {
  id        String   @id @default(uuid())
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   String
  ipAddress String
  rating    Int      // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([movieId, ipAddress])
  @@index([movieId])
}

model SongRequest {
  id              String   @id @default(uuid())
  songName        String
  artistName      String
  lyrics          String?  @db.Text
  youtubeUrl      String?
  spotifyUrl      String?
  email           String
  newsletterOptIn Boolean  @default(false)
  ipAddress       String?
  status          String   @default("pending") // pending, reviewed, completed, rejected
  adminNotes      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model Annotation {
  id        String   @id @default(uuid())
  songId    String
  startLine Int
  endLine   Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @db.Text
  authKey   String
  p256dh    String
  userAgent String?  @db.Text
  ipAddress String?
  status    String   @default("active") // active, unsubscribed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([endpoint(length: 500)])
  @@index([status])
}

model PushNotification {
  id        String    @id @default(uuid())
  title     String
  body      String    @db.Text
  url       String?
  icon      String?
  status    String    @default("draft") // draft, sent
  sentTo    Int       @default(0)
  failedTo  Int       @default(0)
  clicks    Int       @default(0)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PwaInstall {
  id        String   @id @default(uuid())
  userAgent String?  @db.Text
  ipAddress String?
  platform  String?  // android, ios, desktop
  createdAt DateTime @default(now())
}

model AppVisit {
  id        String   @id @default(uuid())
  ipAddress String?
  userAgent String?  @db.Text
  platform  String?  // android, ios, desktop
  referrer  String?
  createdAt DateTime @default(now())

  @@index([ipAddress])
  @@index([createdAt])
}